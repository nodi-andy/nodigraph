{
  "id": "/",
  "name": "nodigraph",
  "short_name": "nodigraph",
  "description": "Recursive system-architecture diagrams: blocks with ports, wires, drill-down. The whole diagram lives in the link.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#247e91",
  "lang": "en",
  "categories": ["productivity", "developer tools", "utilities"],
  "icons": [
    { "src": "icons/favicon-196.png", "sizes": "196x196", "type": "image/png", "purpose": "any" },
    { "src": "icons/manifest-icon-192.maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/manifest-icon-512.maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "screenshots/wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Editing a nested architecture diagram" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/yaml": [".yaml", ".yml"],
        "application/json": [".json"]
      }
    }
  ],
  "launch_handler": { "client_mode": "navigate-existing" }
}
